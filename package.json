{
  "name": "pair-wise-gsb-56",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 18456",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 18456",
    "verify": "npm run verify:logic && npm run verify:api",
    "verify:logic": "esbuild scripts/verify-logic.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-logic.mjs --alias:@=./src && node node_modules/.tmp/verify-logic.mjs",
    "verify:api": "esbuild scripts/verify-api.mts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-api.mjs --alias:@=./src && node node_modules/.tmp/verify-api.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@reduxjs/toolkit": "2.5.0",
    "antd": "5.23.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "9.2.0",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.0.7"
  }
}
